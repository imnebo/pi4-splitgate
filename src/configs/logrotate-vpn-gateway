# src/configs/logrotate-vpn-gateway — deployed to /etc/logrotate.d/vpn-gateway (D-11, D-19). Phase 10.
/etc/splitgate/logs/install.log {
    daily
    rotate 14
    compress
    dateext
    missingok
    notifempty
    create 0640 root root
    sharedscripts
    postrotate
        find /etc/splitgate/logs -name "watch-*.log" -mtime +14 -delete 2>/dev/null || true
    endscript
}
